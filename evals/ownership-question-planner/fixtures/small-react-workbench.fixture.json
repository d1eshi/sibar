    "import * as React from \"react\";",
    "",
    "type SmallWorkbenchProps = {",
    "  title: string;",
    "};",
    "",
    "export function SmallWorkbenchPanel(props: SmallWorkbenchProps) {",
    "  return <section>{props.title}</section>;",
    "}",
    "",
    "export function useSmallReadySignal(enabled: boolean) {",
    "  React.useEffect(() => {",
    "    if (!enabled) {",
    "      return;",
    "    }",
    "    void enabled;",
    "  }, [enabled]);",
    "  return enabled ? \"ready\" : \"pending\";",
    "}",
    "",
    "export default function SmallApp({ title }: SmallWorkbenchProps) {",
    "  const readiness = useSmallReadySignal(true);",
    "  return (",
    "    <main>",
    "      <SmallWorkbenchPanel title={title} />",
    "      <article>{readiness}</article>",
    "    </main>",
    "  );",
    "}"
  ],
